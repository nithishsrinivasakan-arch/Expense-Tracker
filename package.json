{
  "name": "rupee-expense-tracker",
  "version": "1.0.0",
  "description": "Minimalist Indian Rupee Expense Tracker PWA",
  "main": "main.js",
  "scripts": {
    "start": "npx serve .",
    "desktop": "npx electron main.js",
    "css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o app.css --minify",
    "build": "npm run css && node copy-assets.js && npx cap copy",
    "android:sync": "npm run css && node copy-assets.js && npx cap sync",
    "android:open": "npx cap open android"
  },
  "keywords": [
    "expense-tracker",
    "pwa",
    "rupee",
    "finance"
  ],
  "author": "nithishsrinivasakan-arch",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "chart.js": "^4.4.1",
    "pdfjs-dist": "^3.11.174",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
